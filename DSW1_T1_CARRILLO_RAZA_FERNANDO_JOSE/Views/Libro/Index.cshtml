@model IEnumerable<DSW1_T1_CARRILLO_RAZA_FERNANDO_JOSE.Models.Libro>

@{
    ViewData["Title"] = "Listado de libros";
}

<h2>Listado de libros</h2>

@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-success">
        @ViewBag.Mensaje
    </div>
}

<div class="mb-3">
    <a asp-controller="Libro" asp-action="Crear" class="btn btn-primary">
        Registrar libro
    </a>
</div>

<form asp-controller="Libro" asp-action="Index" method="get" class="mb-3">
    <div class="row">
        <div class="col-md-6">
            <input type="text"
                   name="autor"
                   value="@ViewBag.Autor"
                   class="form-control"
                   placeholder="Buscar libros por autor" />
        </div>

        <div class="col-md-3">
            <button type="submit" class="btn btn-success">
                Buscar
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Limpiar
            </a>
        </div>
    </div>
</form>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Nombre del libro</th>
            <th>Autor</th>
            <th>Editorial</th>
            <th>ISDN</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var libro in Model)
        {
            <tr>
                <td>@libro.Id</td>
                <td>@libro.NombreLibro</td>
                <td>@libro.Autor</td>
                <td>@libro.NombreEditorial</td>
                <td>@libro.ISDN</td>
                <td>
                    <a asp-action="Editar"
                       asp-route-id="@libro.Id"
                       class="btn btn-warning btn-sm">
                        Editar
                    </a>

                    <a asp-action="Eliminar"
                       asp-route-id="@libro.Id"
                       class="btn btn-danger btn-sm">
                        Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No se encontraron libros.
    </div>
}
